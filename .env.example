NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
NEXT_PUBLIC_AUTH_URL=https://auth.bridgingchina.net
NEXT_PUBLIC_AMAP_KEY=请替换为高德 JS API key
# 服务端 secret（不加 NEXT_PUBLIC_ 前缀）。prod 用 `wrangler secret put AMAP_SECURITY_CODE`
AMAP_SECURITY_CODE=
# i18n Phase 5 rollback flag. Set to 'false' to disable all English UI
# (middleware 302s /en-US/* → /zh-CN/*, SSE forces Accept-Language: zh-CN).
# Default (unset or any non-'false' value) keeps English enabled.
NEXT_PUBLIC_I18N_ENABLED=true
